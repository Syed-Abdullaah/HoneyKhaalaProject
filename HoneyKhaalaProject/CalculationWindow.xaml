<Window x:Class="HoneyKhaalaProject.CalculationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:HoneyKhaalaProject.VM;assembly=HoneyKhaalaProject.VM"
		xmlns:local="clr-namespace:HoneyKhaalaProject;assembly=HoneyKhaalaProject"
        mc:Ignorable="d"
        Title="Investment Calculation" Height="1000" Width="850"
        Background="#F3F6FA" WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=local:CalculationWindow,IsDesignTimeCreatable=True}" HorizontalContentAlignment="Center">

	<Window.Resources>
		<SolidColorBrush x:Key="ProgressBar.Progress" Color="#FF06B025"/>
		<SolidColorBrush x:Key="ProgressBar.Background" Color="#FFE6E6E6"/>
		<SolidColorBrush x:Key="ProgressBar.Border" Color="#FFBCBCBC"/>
		<Style x:Key="ProgressBarWithCornerRadiusStyle" TargetType="{x:Type ProgressBar}">
			<Setter Property="Foreground" Value="{StaticResource ProgressBar.Progress}"/>
			<Setter Property="Background" Value="{StaticResource ProgressBar.Background}"/>
			<Setter Property="BorderBrush" Value="{StaticResource ProgressBar.Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ProgressBar}">
						<Grid x:Name="TemplateRoot">
							<VisualStateManager.VisualStateGroups>
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="Determinate"/>
									<VisualState x:Name="Indeterminate">
										<Storyboard RepeatBehavior="Forever">
											<DoubleAnimationUsingKeyFrames Storyboard.TargetName="Animation" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
												<EasingDoubleKeyFrame KeyTime="0" Value="0.25"/>
												<EasingDoubleKeyFrame KeyTime="0:0:1" Value="0.25"/>
												<EasingDoubleKeyFrame KeyTime="0:0:2" Value="0.25"/>
											</DoubleAnimationUsingKeyFrames>
											<PointAnimationUsingKeyFrames Storyboard.TargetName="Animation" Storyboard.TargetProperty="(UIElement.RenderTransformOrigin)">
												<EasingPointKeyFrame KeyTime="0" Value="-0.5,0.5"/>
												<EasingPointKeyFrame KeyTime="0:0:1" Value="0.5,0.5"/>
												<EasingPointKeyFrame KeyTime="0:0:2" Value="1.5,0.5"/>
											</PointAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>
							<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/>
							<Rectangle x:Name="PART_Track" RadiusX="12" RadiusY="12" />
							<Grid x:Name="PART_Indicator" ClipToBounds="true" HorizontalAlignment="Left">
								<Rectangle x:Name="Indicator" RadiusX="12" RadiusY="12" Fill="{TemplateBinding Foreground}"/>
								<Rectangle x:Name="Animation" RadiusX="12" RadiusY="12" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
									<Rectangle.RenderTransform>
										<TransformGroup>
											<ScaleTransform/>
											<SkewTransform/>
											<RotateTransform/>
											<TranslateTransform/>
										</TransformGroup>
									</Rectangle.RenderTransform>
								</Rectangle>
							</Grid>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="Orientation" Value="Vertical">
								<Setter Property="LayoutTransform" TargetName="TemplateRoot">
									<Setter.Value>
										<RotateTransform Angle="-90"/>
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsIndeterminate" Value="true">
								<Setter Property="Visibility" TargetName="Indicator" Value="Collapsed"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border CornerRadius="14" Padding="12" Margin="0,0,0,14" Background="#0F172A">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<Ellipse Width="48" Height="48" Fill="White" VerticalAlignment="Center"/>
				<StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
					<TextBlock Text="Calculate Shares" FontSize="18" FontWeight="Bold" Foreground="White"/>
					<TextBlock Text="Enter investors and click Save Snapshot to persist this month's data" FontSize="12" Foreground="#A8B0C0"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="14,10,0,0" Grid.Row="1">
            <Button Content="+ Add Investor" Width="140" Click="AddInvestor_Click" Margin="14,10,0,0"/>
            <Button Content="Calculate" Width="140" Click="Calculate_Click" Background="#2563EB" Foreground="White" Margin="14,10,0,0"/>
            <Button Content="Save" Width="140" Click="Save_Click" Background="Green" Foreground="White" Margin="14,10,0,0"/>
            <Button Content="Open" Width="140" Click="Open_Click" Background="Brown" Foreground="White" Margin="14,10,0,0"/>

            <TextBlock Text="Results :" FontSize="16" FontWeight="Bold" Margin="14,10,0,0" />
			<StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="Total: " Foreground="#6B7280" VerticalAlignment="Center" Margin="5,12,0,0"/>
                <TextBlock Text="{Binding TotalDisplay}" DataContext="{Binding }" FontWeight="Bold" VerticalAlignment="Center" Margin="0,12,0,0"/>
			</StackPanel>
		</StackPanel>

		<ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="2">
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="Black" BorderThickness="5">
				<StackPanel>
					<TextBlock Text="Investors" FontSize="30" HorizontalAlignment="Center" FontFamily="Bahnschrift"/>
					<ListBox x:Name="InvestorsListBox" ItemsSource="{Binding Investors}" Width="550">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<DockPanel Margin="0,6,0,6">
									<StackPanel Width="220" DockPanel.Dock="Left">
										<TextBlock Text="Name" FontSize="11" Foreground="#6B7280"/>
										<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="28" />
									</StackPanel>

									<StackPanel Width="180" Margin="12,0,0,0" DockPanel.Dock="Left">
										<TextBlock Text="Amount (USD)" FontSize="11" Foreground="#6B7280"/>
										<TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="28"/>
									</StackPanel>
									
										
									<Button Content="Remove" Width="70" Height="28"  VerticalAlignment="Bottom" Margin="20,0,0,0" Click="RemoveInvestor_Click" Tag="{Binding}" />
									
								</DockPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</StackPanel>
			</Border>
		</ScrollViewer>

		<ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="3">
			<Border Background="White" CornerRadius="12" Padding="14" BorderBrush="Black" BorderThickness="5">
				<StackPanel>
                    <TextBlock Text="Percentages" FontSize="30" FontFamily="Bahnschrift" HorizontalAlignment="Center"/>
					<ListBox ItemsSource="{Binding Investors}" Margin="0,10,0,0" Width="410" >
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="0,8,0,8">
									<DockPanel>
										<TextBlock Text="{Binding Name}" FontWeight="Bold" Width="200"/>
										<TextBlock Text="{Binding Amount, StringFormat=C2}" Width="120" HorizontalAlignment="Right" Foreground="#111827"/>
										<TextBlock Text="{Binding Percentage, StringFormat=F1}" Width="80" HorizontalAlignment="Right" Foreground="#6B7280"/>
									</DockPanel>

									<Grid Margin="0,6,0,0" Height="26">
										<ProgressBar Style="{StaticResource ProgressBarWithCornerRadiusStyle}" Value="{Binding Percentage}" Height="26">
											<ProgressBar.Background>
												<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
													<GradientStop Offset="0" Color="#4F46E5"/>
													<GradientStop Offset="1" Color="#06B6D4"/>
												</LinearGradientBrush>
											</ProgressBar.Background>
										</ProgressBar>
										<TextBlock Text="{Binding Percentage, StringFormat='F1%'}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" Margin="8,0,8,0" VerticalAlignment="Center"/>
									</Grid>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</StackPanel>
			</Border>
		</ScrollViewer>
	</Grid>
</Window>