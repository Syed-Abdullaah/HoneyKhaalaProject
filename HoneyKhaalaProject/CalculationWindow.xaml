<Window x:Class="HoneyKhaalaProject.CalculationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:HoneyKhaalaProject.VM;assembly=HoneyKhaalaProject.VM"
		xmlns:local="clr-namespace:HoneyKhaalaProject;assembly=HoneyKhaalaProject"
        mc:Ignorable="d"
        Title="Investment Calculation" Height="1000" Width="1000"
        Background="#F3F6FA" WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=local:CalculationWindow,IsDesignTimeCreatable=True}" HorizontalContentAlignment="Center" WindowState="Maximized">

    <Window.Resources>
        <SolidColorBrush x:Key="ProgressBar.Progress" Color="#FF06B025"/>
        <SolidColorBrush x:Key="ProgressBar.Background" Color="#FFE6E6E6"/>
        <SolidColorBrush x:Key="ProgressBar.Border" Color="#FFBCBCBC"/>
        <Style x:Key="ProgressBarWithCornerRadiusStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Foreground" Value="{StaticResource ProgressBar.Progress}"/>
            <Setter Property="Background" Value="{StaticResource ProgressBar.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ProgressBar.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="TemplateRoot">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Determinate"/>
                                    <VisualState x:Name="Indeterminate">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Animation" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                                <EasingDoubleKeyFrame KeyTime="0" Value="0.25"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0.25"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0.25"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <PointAnimationUsingKeyFrames Storyboard.TargetName="Animation" Storyboard.TargetProperty="(UIElement.RenderTransformOrigin)">
                                                <EasingPointKeyFrame KeyTime="0" Value="-0.5,0.5"/>
                                                <EasingPointKeyFrame KeyTime="0:0:1" Value="0.5,0.5"/>
                                                <EasingPointKeyFrame KeyTime="0:0:2" Value="1.5,0.5"/>
                                            </PointAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/>
                            <Rectangle x:Name="PART_Track" RadiusX="12" RadiusY="12" />
                            <Grid x:Name="PART_Indicator" ClipToBounds="true" HorizontalAlignment="Left">
                                <Rectangle x:Name="Indicator" RadiusX="12" RadiusY="12" Fill="{TemplateBinding Foreground}"/>
                                <Rectangle x:Name="Animation" RadiusX="12" RadiusY="12" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="LayoutTransform" TargetName="TemplateRoot">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsIndeterminate" Value="true">
                                <Setter Property="Visibility" TargetName="Indicator" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- New row for profit summary -->
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border CornerRadius="14" Padding="12" Margin="0,0,0,14" Background="#0F172A">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="48" Height="48" Fill="White" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Calculate Shares" FontSize="18" FontWeight="Bold" Foreground="White"
                               ToolTip="Window title: manage investors and profit distribution"/>
                    <TextBlock Text="Enter investors and click Save to persist this month's data" FontSize="12" Foreground="#A8B0C0"
                               ToolTip="Instructions: fill contributions per business and per-business profits, then click Calculate and Save"/>
                    <!-- show which month is being edited -->
                    <TextBlock Text="{Binding SelectedMonthDisplay}" FontSize="12" Foreground="#9CA3AF" Margin="0,6,0,0"
                               ToolTip="The month currently being edited"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="14,10,0,0" Grid.Row="1" Height="40">
            <Button Content="➕ Add Investor" ToolTip="Add a new investor row" Width="140" Click="AddInvestor_Click" FontSize="15" FontWeight="Bold" Margin="0,0,20,0"/>
            <Button Content="🧮 Calculate" ToolTip="Calculate profit shares for all businesses" Width="140" Click="Calculate_Click" Background="#2563EB" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,20,0"/>
            <Button Content="💾 Save" ToolTip="Save this month's businesses, contributions and profits" Width="140" Click="Save_Click" Background="Green" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,20,0"/>
            <Button Content="📂 Open" ToolTip="Open a saved month for viewing or editing" Width="140" Click="Open_Click" Background="Brown" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,20,0"/>
        </StackPanel>

        <!-- New totals/profit summary row -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12" Margin="18,8,18,8" BorderBrush="#2563EB" BorderThickness="2" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Summary" FontSize="24" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,0,0,8"
                           ToolTip="Summary of totals and per-business profit inputs"/>
                <ListBox Width="1350" ToolTip="Summary list (total investment and per-business profits)">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="8" Margin="8,0,8,0" BorderBrush="#2563EB" BorderThickness="3">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="Total Investment" FontSize="14" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"
                                           ToolTip="Sum of all contributions across all businesses"/>
                                <TextBlock Text="{Binding TotalInvestmentDisplay}" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="10"
                                           ToolTip="Formatted total investment"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Businesses}" Margin="12,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="8" Margin="8,0,8,0" BorderBrush="#2563EB" BorderThickness="1">
                                        <StackPanel Width="200">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"
                                                       ToolTip="Business name"/>
                                            <TextBox Text="{Binding ProfitString, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="14" HorizontalContentAlignment="Center" ToolTip="Enter profit for this business (number or currency)"/>
                                            <TextBlock Text="{Binding ProfitDisplay}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                       ToolTip="Formatted profit for this business"/>
                                            <TextBlock Text="{Binding ProfitDisplay}" FontSize="20" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                       ToolTip="Total investment in this buisness"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ListBox>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="3">
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="Black" BorderThickness="5">
                <StackPanel>
                    <TextBlock Text="Investors" FontSize="30" HorizontalAlignment="Center" FontFamily="Bahnschrift" ToolTip="List of investors"/>
                    <ListBox x:Name="InvestorsListBox" ItemsSource="{Binding Investors}" Width="1400">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,6">
                                    <DockPanel>
                                        <StackPanel Width="250" DockPanel.Dock="Left">
                                            <TextBlock Text="Name" FontSize="11" Foreground="#6B7280" ToolTip="Investor name label"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="28" ToolTip="Enter investor full name" BorderThickness="3" BorderBrush="Black" />
                                        </StackPanel>

                                        <!-- per-business contributions -->
                                        <ItemsControl ItemsSource="{Binding Contributions}" Margin="12,0,0,0" DockPanel.Dock="Left">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="16,0,16,0">
                                                        <TextBlock Text="{Binding BusinessName}" FontSize="11" Foreground="#6B7280" TextAlignment="Center" ToolTip="Business for this contribution"/>
                                                        <TextBox Text="{Binding AmountString, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" ToolTip="Enter amount contributed to this business (numbers only)"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayProfit}" FontSize="11" ToolTip="Profit share for this investor in this business"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding HalfAmount, StringFormat=C2}" TextAlignment="Right" FontSize="11" HorizontalAlignment="Right" ToolTip="Company share"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="Remove" Width="70" Height="28" VerticalAlignment="Center" Margin="20,0,0,0" Click="RemoveInvestor_Click" Tag="{Binding}" ToolTip="Remove this investor"/>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="4">
            <Border Background="White" CornerRadius="12" Padding="14" BorderBrush="Black" BorderThickness="5">
                <StackPanel>
                    <TextBlock Text="Percentages" FontSize="30" FontFamily="Bahnschrift" HorizontalAlignment="Center" ToolTip="Investor percentages and total profit"/>
                    <ListBox ItemsSource="{Binding Investors}" Margin="0,10,0,0" Width="460">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,8">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Width="140" ToolTip="Investor name"/>
                                        <TextBlock Text="{Binding Amount, StringFormat=C2}" Width="120" HorizontalAlignment="Right" Foreground="#111827" ToolTip="Legacy total amount"/>
                                        <TextBlock Text="{Binding Percentage, StringFormat={}{0:F2} %}" Width="80" HorizontalAlignment="Right" Foreground="#6B7280" ToolTip="Investor percentage across all businesses"/>
                                        <TextBlock Text="{Binding DisplayProfit}" Width="100" HorizontalAlignment="Right" Foreground="#0F172A" FontWeight="SemiBold" ToolTip="Investor total profit across all businesses"/>
                                    </DockPanel>

                                    <Grid Margin="0,6,0,0" Height="26">
                                        <ProgressBar Style="{StaticResource ProgressBarWithCornerRadiusStyle}" Value="{Binding Percentage}" Height="26">
                                            <ProgressBar.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0" Color="#4F46E5"/>
                                                    <GradientStop Offset="1" Color="#06B6D4"/>
                                                </LinearGradientBrush>
                                            </ProgressBar.Background>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding Percentage, StringFormat={}{0:F2} %}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" Margin="8,0,8,0" VerticalAlignment="Center" ToolTip="Investor percentage (visual)"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>